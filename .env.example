# Copy this file to .env and fill it in. .env is ignored by git.
# Which model to use: mock (no key needed), claude (Anthropic API) or foundry (Claude on Microsoft Foundry)
KB_MODEL=mock

# Model name for claude, or the deployment name for foundry
KB_CLAUDE_MODEL=claude-sonnet-5-5

# Only for KB_MODEL=claude. Use a key from León's company account, and confirm
# with Amed before sending anything other than dummy data.
ANTHROPIC_API_KEY=

# Only for KB_MODEL=foundry (Claude on León's Azure subscription)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
