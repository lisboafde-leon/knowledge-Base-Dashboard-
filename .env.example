# Copy this file to .env and fill it in. .env is ignored by git.
# Which model to use: mock (no key needed) or claude
KB_MODEL=mock

# Only needed when KB_MODEL=claude. Use a key from León's company account,
# and confirm with Amed before sending anything other than dummy data.
ANTHROPIC_API_KEY=
KB_CLAUDE_MODEL=claude-sonnet-5-5
